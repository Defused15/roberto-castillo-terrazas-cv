{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "jest",

  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js"
  },

  "coverageAnalysis": "off",

  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",

  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },

  "mutate": [
    "src/components/resume-content.tsx",
    "src/components/language-provider.tsx",
    "src/components/language-toggle.tsx",
    "src/components/project-card.tsx",
    "src/components/darkmode.tsx",
    "src/components/profile-avatar.tsx",
    "src/components/ui/section.tsx",
    "src/data/resume-data.types.ts",
    "src/app/structured-data.ts",
    "src/lib/**/*.ts",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],

  "ignorePatterns": [
    "reports",
    "coverage",
    "jest-report",
    ".next",
    ".stryker-tmp",
    ".superpowers",
    ".playwright-mcp"
  ]
}
